# ---------------------------------------------------------------------------
# Clinic Platform — environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Supabase (Auth, Storage, public API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Database (Drizzle). Use the Supabase connection POOLER URL (port 6543).
# Example: postgresql://postgres.<ref>:<password>@aws-...pooler.supabase.com:6543/postgres
DATABASE_URL=

# Email (Resend) — appointment reminders / transactional mail.
# Optional: with no key, emails are logged to the console (no-op), not sent.
RESEND_API_KEY=
# From address for outgoing email (must be a Resend-verified domain in prod).
EMAIL_FROM="Clinic <onboarding@resend.dev>"

# SMS — appointment reminders / status messages.
# Which channels a clinic actually uses is CONFIG (notifications.channels in the
# clinic config), not env; these credentials just make the "sms" channel work.
# Optional: with no provider, SMS is logged to the console (no-op), not sent.
#
#   SMS_PROVIDER=twilio   → needs TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM
#   SMS_PROVIDER=webhook  → needs SMS_WEBHOOK_URL; POSTs {"to","text"} as JSON.
#                           Use this for a local carrier gateway — no code change.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A purchased number ("+15005550006") or a Messaging Service SID ("MG…").
TWILIO_FROM=
SMS_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <token>" to the webhook above.
SMS_WEBHOOK_TOKEN=

# Secret protecting the reminders cron endpoint (/api/cron/reminders).
# Vercel Cron sends this automatically as a Bearer token when set.
CRON_SECRET=
